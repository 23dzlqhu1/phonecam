<?xml version="1.0" encoding="utf-8"?>
<!-- SCI 仪器风格 — 调试日志页 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_oled">

    <!-- 日志区 -->
    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- 底部操作行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/surface_1"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_push_background"
            android:textColor="@color/text_on_brand"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:text="@string/debug_btn_clear" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_push_background"
            android:textColor="@color/text_on_brand"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:text="@string/debug_btn_copy" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/btn_push_background"
            android:textColor="@color/text_on_brand"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:text="暂停" />
    </LinearLayout>
</LinearLayout>
