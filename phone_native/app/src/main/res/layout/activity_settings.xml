<?xml version="1.0" encoding="utf-8"?>
<!-- SCI 仪器风格设置页 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_oled"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- 相机 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textSize="11sp"
            android:textColor="@color/text_disabled"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:text="@string/settings_section_camera" />

        <include android:id="@+id/rowLens" layout="@layout/item_settings_row" />
        <include android:id="@+id/rowResolution" layout="@layout/item_settings_row" />
        <include android:id="@+id/rowFps" layout="@layout/item_settings_row" />

        <!-- 连接 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textSize="11sp"
            android:textColor="@color/text_disabled"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:text="@string/settings_section_connect" />

        <include android:id="@+id/rowPcDiscovery" layout="@layout/item_settings_row" />
        <include android:id="@+id/rowConnect" layout="@layout/item_settings_row" />

        <!-- 调试 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textSize="11sp"
            android:textColor="@color/text_disabled"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:text="@string/settings_section_debug" />

        <include android:id="@+id/rowShowDebug" layout="@layout/item_settings_row" />
        <include android:id="@+id/rowDebug" layout="@layout/item_settings_row" />
        <include android:id="@+id/rowAbout" layout="@layout/item_settings_row" />

        <!-- 版本号 -->
        <TextView
            android:id="@+id/footerVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/text_disabled" />
    </LinearLayout>
</ScrollView>
