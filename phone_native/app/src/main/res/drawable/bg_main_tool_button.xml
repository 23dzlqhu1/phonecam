<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity 首页工具按钮 UI 层背景；不影响推流链路 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/main_tool_bg_pressed" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/main_tool_bg" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hairline" />
        </shape>
    </item>
</selector>
