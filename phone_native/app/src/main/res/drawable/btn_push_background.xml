<?xml version="1.0" encoding="utf-8"?>
<!--
  btn_push_background.xml — 推流按钮背景 (Layer C)
  默认态: surface_1 底 + 1px brand_cyan 边 + 16dp 圆角 (pill)
  按下态: 透明度 0.7 (state_pressed)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_1" />
            <stroke android:width="1dp" android:color="@color/brand_cyan" />
            <corners android:radius="@dimen/btn_push_corner" />
            <padding
                android:left="24dp"
                android:right="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_1" />
            <stroke android:width="1dp" android:color="@color/brand_cyan" />
            <corners android:radius="@dimen/btn_push_corner" />
            <padding
                android:left="24dp"
                android:right="24dp" />
        </shape>
    </item>
</selector>
