<?xml version="1.0" encoding="utf-8"?>
<!-- SCI 科研仪器风格 — 浅色主题 -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_oled</item>
        <item name="android:statusBarColor">@color/surface_1</item>
        <item name="android:navigationBarColor">@color/surface_1</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="colorPrimary">@color/brand_cyan</item>
        <item name="colorPrimaryDark">@color/surface_1</item>
        <item name="colorAccent">@color/brand_cyan</item>
        <item name="colorControlNormal">@color/text_disabled</item>
        <item name="colorControlActivated">@color/brand_cyan</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme" />

    <style name="AppTheme.WithActionBar" parent="Theme.AppCompat.Light">
        <item name="android:windowBackground">@color/bg_oled</item>
        <item name="android:statusBarColor">@color/surface_1</item>
        <item name="android:navigationBarColor">@color/surface_1</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="colorPrimary">@color/surface_1</item>
        <item name="colorPrimaryDark">@color/surface_1</item>
        <item name="colorAccent">@color/brand_cyan</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="actionBarStyle">@style/AppTheme.ActionBar</item>
        <item name="actionBarTheme">@style/AppTheme.ActionBar</item>
    </style>

    <style name="AppTheme.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/surface_1</item>
        <item name="titleTextStyle">@style/AppTheme.ActionBar.Title</item>
        <item name="homeAsUpIndicator">@drawable/ic_back</item>
    </style>

    <style name="AppTheme.ActionBar.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
