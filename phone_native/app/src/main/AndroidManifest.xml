<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — phone_native/ App 清单
  MVP-2 批次 3 + Phase X + 批次 3.2.0.3b 范围：
    - CAMERA 权限
    - INTERNET 权限 (批次 3.2.0.3b: TcpStreamServer 监听 9999 需网络权限)
    - MainActivity (LAUNCHER, NoActionBar 主题)
    - Settings / Connect / About / Debug 4 个 Activity 壳 (WithActionBar 主题)

  批次 3.2.0.3f 新增:
    - FOREGROUND_SERVICE 权限 (启前台 Service 必需)
    - FOREGROUND_SERVICE_CAMERA 权限 (Android 14+ 要求前台 Service 标 type=camera)
    - POST_NOTIFICATIONS 权限 (Android 13+ 通知需用户授权)
    - <service> 注册 StreamingService (前台 Service, 推流用)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 批次 3：申请相机权限以打开后置摄像头预览 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 批次 3.2.0.3b：INTERNET 权限 (TcpStreamServer 用 ServerSocket 监听 9999 需此权限) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 批次 3.2.0.3f：前台 Service 权限 (Oplus Hans 冻结回避, startForeground 必需) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 批次 3.2.0.3f：Android 14+ (API 34) 要求前台 Service 标 type=camera -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- 批次 3.2.0.3f：Android 13+ (API 33) 通知需用户授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <!-- MainActivity: App 入口 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SettingsActivity: 设置页 (Phase X 占位) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.WithActionBar"
            android:parentActivityName=".MainActivity" />

        <!-- ConnectActivity: 连接 PC 页 (Phase X 占位) -->
        <activity
            android:name=".ConnectActivity"
            android:exported="false"
            android:theme="@style/AppTheme.WithActionBar"
            android:parentActivityName=".MainActivity" />

        <!-- AboutActivity: 关于页 (Phase X 占位) -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/AppTheme.WithActionBar"
            android:parentActivityName=".MainActivity" />

        <!-- DebugActivity: 调试日志页 (Phase X 占位) -->
        <activity
            android:name=".DebugActivity"
            android:exported="false"
            android:theme="@style/AppTheme.WithActionBar"
            android:parentActivityName=".MainActivity" />

        <!-- 批次 3.2.0.3f: 前台 Service 推流 (Hans 冻结回避) -->
        <service
            android:name=".StreamingService"
            android:exported="false"
            android:foregroundServiceType="camera" />

    </application>

</manifest>
