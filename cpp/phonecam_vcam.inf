DriverVer=06/14/2026,1.0.0.0
CatalogFile=PhoneCam.cat

[DestinationDirs]
DefaultDestDir=13

[Manufacturer]
%MfgName%=DeviceInstall,NTamd64

[DeviceInstall.NTamd64]
%DeviceDesc%=DeviceInstall, root\PhoneCamV0

[DeviceInstall.NT]
CopyFiles=

[DeviceInstall.NT.HW]
AddReg=DeviceReg

[DeviceReg]
HKR,,CLSID,,%ProxyVCap.CLSID%
HKR,,FriendlyName,,%DeviceDesc%
HKR,,CustomCaptureSourceClsid,,%CustomCaptureSource.CLSID%

[DeviceInstall.NT.Interfaces]
AddInterface=%KSCATEGORY_VIDEO_CAMERA%,%ReferenceString%,CameraInterface
AddInterface=%KSCATEGORY_VIDEO%,%ReferenceString%,CameraInterface
AddInterface=%KSCATEGORY_CAPTURE%,%ReferenceString%,CameraInterface

[CameraInterface]
AddReg=CameraInterfaceReg

[CameraInterfaceReg]
HKR,,CLSID,,%ProxyVCap.CLSID%
HKR,,FriendlyName,,%DeviceDesc%

[DeviceInstall.NT.Services]
; No service needed — this is a COM-based virtual camera

